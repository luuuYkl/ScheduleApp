{
  "name": "my-schedule-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "electron/main.js",
  "author": "ScheduleApp Team",
  "description": "日程管理应用 - 桌面版",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "coverage": "vitest run --coverage",
    "electron:dev": "concurrently -k \"cross-env BROWSER=none vite\" \"wait-on http://localhost:5173 && cross-env NODE_ENV=development electron .\"",
    "electron:build": "npm run build && npm run compile:electron && electron-builder",
    "electron:build:win": "npm run build && npm run compile:electron && electron-builder --win --x64",
    "compile:electron": "tsc -p tsconfig.electron.json",
    "compile:bytecode": "node scripts/compile-bytecode.js",
    "build:protected": "npm run build && npm run compile:electron && npm run compile:bytecode && electron-builder --win --x64"
  },
  "dependencies": {
    "@arco-design/web-vue": "^2.57.0",
    "axios": "^1.12.2",
    "pinia": "^3.0.3",
    "vue": "^3.5.21",
    "vue-router": "^4.6.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.9.1",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vitest/coverage-v8": "^4.0.3",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.8.1",
    "bytenode": "^1.5.7",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "eslint-plugin-vue": "^10.8.0",
    "javascript-obfuscator": "^4.1.0",
    "jsdom": "^27.0.1",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.56.0",
    "vite": "^7.1.7",
    "vite-plugin-javascript-obfuscator": "^3.1.0",
    "vitest": "^4.0.3",
    "vue-eslint-parser": "^10.4.0",
    "vue-tsc": "^3.2.4",
    "wait-on": "^7.2.0"
  }
}