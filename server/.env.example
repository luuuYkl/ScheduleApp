#1 ===========================================
# 智远日程 - 后端环境变量配置
# ===========================================
# 说明：复制此文件为 .env 并填写实际配置值

# ===========================================
# 服务器配置
# ===========================================
PORT=3000
NODE_ENV=production

# 前端 URL（用于 CORS 配置）
FRONTEND_URL=http://localhost:5173

# ===========================================
# 数据库配置 - 本地 MySQL
# ===========================================
# 数据库主机地址（本地安装使用 localhost）
DB_HOST=localhost

# 数据库端口
DB_PORT=3306

# 数据库用户名
DB_USER=root

# 数据库密码（请修改为你的实际密码）
DB_PASSWORD=your_password_here

# 数据库名称
DB_NAME=schedule_app

# ===========================================
# JWT 配置
# ===========================================
# JWT 密钥（请使用强密码，生产环境请修改！）
JWT_SECRET=your-super-secret-jwt-key-change-this

# JWT 过期时间
JWT_EXPIRES_IN=7d

# ===========================================
# 可选配置
# ===========================================
# 调试模式（开发时设为 true）
DEBUG=false